# Copy to .env and change the key before deploying.
# Admin key for the /api admin endpoints (header: X-Admin-Key).
# Default dev value is "change-me" — never use it in production.
ADMIN_KEY=change-me
# Optional: sqlite file location. Default: sqlite:///./portfolio.db
DATABASE_URL=sqlite:///./portfolio.db
# Optional: port the API listens on. Default: 8000
PORT=8000
